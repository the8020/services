{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "/p/": "file:///workspace/packages/",
    "@the8020/kernel": "file:///opt/runtime/kernel/mod.ts",
    "kysely": "npm:kysely@0.29.4"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check --import-map=deno.local.json tables/*.ts src/*.ts programs/*/*.ts",
    "test": "deno test --import-map=deno.local.json ."
  }
}
