{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "/p/": "file:///workspace/packages/",
    "@the8020/kernel": "file:///opt/runtime/kernel/mod.ts",
    "kysely": "npm:kysely@0.29.4",
    "@the8020/http": "file:///opt/runtime/http/the8020_http.js",
    "@the8020/context": "file:///opt/runtime/context/mod.ts",
    "hono": "jsr:@hono/hono@4.9.8",
    "zod": "npm:zod@4.1.5"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check --import-map=deno.local.json types/*.ts tables/*.ts src/*.ts programs/*/*.ts",
    "test": "deno test --import-map=deno.local.json --allow-read=.,/tmp --allow-write=/tmp ."
  }
}
