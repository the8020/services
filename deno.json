{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "fmt": { "exclude": ["vendor"] },
  "lint": { "exclude": ["vendor"] },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "bundle": "bash build-dependencies.sh",
    "check": "bash -n build-dependencies.sh && deno fmt --check . && deno lint . && deno check http.ts http_test.ts types/*.ts tables/*.ts src/*.ts programs/*/*.ts",
    "test": "deno test --allow-read=.,/tmp --allow-write=/tmp ."
  }
}
